    "meteor",
    "rtl-tcp-passive",
    "rtl-tcp-active"
  ],
  "plugin_states": {
    "webserver": {"enabled": true, "host": "0.0.0.0", "port": 8080},
    "constellation": {
      "symrate": 10500,
      "m": 8,
      "ref_angle": 0.0,
      "differential": true,
      "gating": true
    }
  }
