# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# macOS metadata
.DS_Store

# SDRTerm recordings
sdrterm_*.iq
sdrterm_*.wav
sdrterm_*.sigmf-data
sdrterm_*.sigmf-meta

# Third-party IQ recordings dropped into samples/ for local testing
samples/SDRuno_*.wav

# SDRTerm user presets (root-level only; presets/ directory is versioned)
*.sdrterm
!presets/*.sdrterm

# Retrained / user-replaced model files (keep the shipped modclass_lite.onnx)
plugins/modclass/models/*_custom.onnx

# Downloaded datasets (large binary files, not versioned)
data/

# Iridium plugin burst captures (Stage 2a) — decoded by decode_bursts.sh
plugins/iridium/iridium_bursts/

# iridium_decoder session logs (created via `s` shortcut) — user's captures
iridium_logs/

# adsb plugin telemetry logs — user's captures, one CSV appended forever
plugins/adsb/adsb_logs/

# LaTeX build artefacts under plugins/iridium_decoder/docs/
plugins/iridium_decoder/docs/*.aux
plugins/iridium_decoder/docs/*.log
plugins/iridium_decoder/docs/*.out
plugins/iridium_decoder/docs/*.toc
plugins/iridium_decoder/docs/*.pdf

# LaTeX build artefacts under plugins/adsb/docs/
plugins/adsb/docs/*.aux
plugins/adsb/docs/*.log
plugins/adsb/docs/*.out
plugins/adsb/docs/*.toc
plugins/adsb/docs/*.pdf
